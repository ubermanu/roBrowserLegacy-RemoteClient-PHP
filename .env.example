# Copy this file to .env and adjust as needed.
# Every setting is optional - defaults are defined in configs.php.

# Debug trace output (disable in production!)
DEBUG=

# Game client files location (GRFs + DATA.INI, and the data/BGM/System/AI folders)
#CLIENT_RESPATH=data/
#CLIENT_DATAPATH=data/
#CLIENT_DATAINI=DATA.INI

# Extract requested GRF files to disk so the web server can serve them directly
CLIENT_AUTOEXTRACT=1

# Enable the POST search endpoint (only needed for the GRF/Map/Model viewers)
CLIENT_ENABLESEARCH=

# GRF filename encoding: CP949 (Korean), CP874 (Thai), ISO-8859-1, UTF-8
#GRF_ENCODING=CP949

# PHP memory limit for the extraction script
#MEMORY_LIMIT=1000M

# Response compression (usually better handled by Apache/Nginx)
#COMPRESSION_ENABLED=
#COMPRESSION_MIN_SIZE=1024
#COMPRESSION_LEVEL=6

# In-memory LRU file cache (daemon mode only)
#CACHE_ENABLED=
#CACHE_MAX_FILES=100
#CACHE_MAX_MEMORY_MB=256

# Persistent file index cache (daemon mode only)
#INDEX_CACHE_ENABLED=
#INDEX_CACHE_DIR=cache/

# Missing files log
#MISSING_LOG_ENABLED=
#MISSING_LOG_FILE=logs/missing-files.log
#MISSING_LOG_MAX_ENTRIES=1000

# Korean path mapping (see tools/convert-encoding.php)
#PATH_MAPPING_ENABLED=1
#PATH_MAPPING_FILE=path-mapping.json
